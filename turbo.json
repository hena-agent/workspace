{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "HENA_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "HENA_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "hena#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@hena/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hena/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hena/app-v3#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hena/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hena/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hena/script#test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.github/actions/run-opencode/**"],
      "outputs": []
    },
    "@hena/tui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
