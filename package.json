{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "hena",
  "description": "Hena, an AI-powered development tool",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun run --cwd packages/hena --conditions=browser src/index.ts",
    "dev:desktop": "bun --cwd packages/desktop dev",
    "dev:web": "bun --cwd packages/app dev",
    "dev:storybook": "bun --cwd packages/storybook storybook",
    "build:opencode-plugin": "bun run script/opencode/build-codex-web-search.ts",
    "check:opencode-plugin": "bun run script/opencode/build-codex-web-search.ts --check",
    "knip": "knip-bun",
    "lint": "oxlint",
    "typecheck": "bun turbo typecheck",
    "postinstall": "bun run --cwd packages/core fix-node-pty",
    "prepare": "husky",
    "random": "echo 'Random script'",
    "translate:app": "bun run script/translate-app.ts",
    "test": "echo 'do not run tests from root' && exit 1",
    "doctor": "npx react-doctor@latest"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/sdk/js"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.0-beta.83",
      "@effect/platform-node": "4.0.0-beta.83",
      "@effect/sql-sqlite-bun": "4.0.0-beta.83",
      "@npmcli/arborist": "9.4.0",
      "@types/bun": "1.3.13",
      "@types/cross-spawn": "6.0.6",
      "@octokit/rest": "22.0.0",
      "@hono/standard-validator": "0.2.0",
      "@tanstack/solid-virtual": "3.13.32",
      "@shikijs/stream": "4.2.0",
      "ulid": "3.0.1",
      "@kobalte/core": "0.13.11",
      "@corvu/drawer": "0.2.4",
      "@types/luxon": "3.7.1",
      "@types/node": "24.12.2",
      "@types/semver": "7.7.1",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@pierre/diffs": "1.2.10",
      "@solid-primitives/storage": "4.3.3",
      "@tailwindcss/vite": "4.3.3",
      "diff": "8.0.2",
      "drizzle-kit": "1.0.0-rc.2",
      "drizzle-orm": "1.0.0-rc.2",
      "effect": "4.0.0-beta.83",
      "ai": "6.0.168",
      "cross-spawn": "7.0.6",
      "hono": "4.12.16",
      "fuzzysort": "3.1.0",
      "luxon": "3.6.1",
      "marked": "17.0.6",
      "marked-shiki": "1.2.1",
      "remend": "1.3.0",
      "@playwright/test": "1.59.1",
      "semver": "7.7.4",
      "@typescript/native": "npm:typescript@7.0.2",
      "typescript": "6.0.2",
      "zod": "4.1.8",
      "remeda": "2.26.0",
      "shiki": "4.2.0",
      "solid-list": "0.3.0",
      "tailwindcss": "4.3.3",
      "vite": "8.2.1",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "0.16.3",
      "@sentry/solid": "10.36.0",
      "@sentry/vite-plugin": "5.4.0",
      "solid-js": "1.9.14",
      "vite-plugin-solid": "2.11.14",
      "@lydell/node-pty": "1.2.0-beta.12"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/mime-types": "3.0.1",
    "husky": "9.1.7",
    "knip": "6.32.0",
    "marked": "catalog:",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "react-doctor": "0.9.5",
    "turbo": "2.10.2"
  },
  "dependencies": {
    "@opencode-ai/plugin": "workspace:*",
    "@hena/script": "workspace:*",
    "@hena/sdk": "workspace:*",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hena-agent/hena"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "bun-types",
    "esbuild",
    "node-pty",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "tree-sitter-powershell",
    "web-tree-sitter",
    "electron"
  ],
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-orm": "catalog:",
    "vite": "catalog:"
  },
  "patchedDependencies": {
    "@npmcli/agent@4.0.2": "patches/@npmcli%2Fagent@4.0.2.patch",
    "@silvia-odwyer/photon-node@0.3.4": "patches/@silvia-odwyer%2Fphoton-node@0.3.4.patch",
    "@ai-sdk/xai@3.0.102": "patches/@ai-sdk%2Fxai@3.0.102.patch",
    "@ai-sdk/mistral@3.0.34": "patches/@ai-sdk%2Fmistral@3.0.34.patch",
    "pacote@21.5.1": "patches/pacote@21.5.1.patch",
    "@ai-sdk/google@3.0.73": "patches/@ai-sdk%2Fgoogle@3.0.73.patch",
    "@pierre/trees@1.0.0-beta.4": "patches/@pierre%2Ftrees@1.0.0-beta.4.patch",
    "@modelcontextprotocol/sdk@1.29.0": "patches/@modelcontextprotocol%2Fsdk@1.29.0.patch",
    "effect@4.0.0-beta.83": "patches/effect@4.0.0-beta.83.patch",
    "@tanstack/virtual-core@3.17.3": "patches/@tanstack%2Fvirtual-core@3.17.3.patch"
  }
}
