{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@hena/server-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./portless": "./src/portless.ts",
    "./protocol": "./src/protocol.ts",
    "./start": "./src/main.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "bunx --package @typescript/native tsc --noEmit"
  },
  "dependencies": {
    "@hena/core": "workspace:*",
    "@hena/schema": "workspace:*",
    "@hono/standard-validator": "catalog:",
    "effect": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:"
  }
}
