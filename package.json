{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "hena",
  "description": "Hena, an AI-powered development tool",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "bun run --cwd packages/hena --conditions=browser src/index.ts",
    "dev:desktop": "bun --cwd packages/desktop dev",
    "dev:web": "bun --cwd packages/app dev",
    "dev:v3": "portless run --name hena-v3 bun run dev:v3:local",
    "dev:v3:local": "bun run --parallel --no-orphans --filter @hena/app-v3 --filter @hena/server-v3 dev",
    "dev:v3:tailscale": "portless run --name hena-v3 --tailscale bun run dev:v3:local",
    "dev:storybook": "bun --cwd packages/storybook storybook",
    "knip": "knip-bun",
    "lint": "oxlint",
    "typecheck": "bun turbo typecheck",
    "postinstall": "bun run --cwd packages/core fix-node-pty",
    "prepare": "husky",
    "random": "echo 'Random script'",
    "translate:app": "bun run script/translate-app.ts",
    "test": "echo 'do not run tests from root' && exit 1",
    "doctor": "react-doctor --project @hena/app-v3 --scope changed --base origin/develop --blocking warning"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/sdk/js"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.0-beta.83",
      "@effect/platform-node": "4.0.0-beta.83",
      "@effect/sql-sqlite-bun": "4.0.0-beta.83",
      "@npmcli/arborist": "10.0.2",
      "@types/bun": "1.4.1",
      "@types/cross-spawn": "6.0.6",
      "@octokit/rest": "22.0.1",
      "@hono/standard-validator": "0.4.0",
      "@tanstack/solid-virtual": "3.13.37",
      "@shikijs/stream": "4.4.3",
      "ulid": "3.0.2",
      "@kobalte/core": "0.13.13",
      "@corvu/drawer": "0.2.4",
      "@types/luxon": "3.7.5",
      "@types/node": "26.4.1",
      "@types/semver": "7.8.0",
      "@tsconfig/node22": "22.0.6",
      "@tsconfig/bun": "1.0.11",
      "@pierre/diffs": "1.4.1",
      "@solid-primitives/storage": "4.4.0",
      "@tailwindcss/vite": "4.3.3",
      "diff": "9.0.0",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "effect": "4.0.0-beta.83",
      "ai": "6.0.277",
      "cross-spawn": "7.0.6",
      "hono": "4.13.7",
      "fuzzysort": "4.0.2",
      "luxon": "3.7.2",
      "marked": "18.0.11",
      "marked-shiki": "1.2.1",
      "remend": "1.3.1",
      "@playwright/test": "1.63.0",
      "semver": "7.8.5",
      "@typescript/native": "npm:typescript@7.0.2",
      "typescript": "6.0.3",
      "zod": "4.5.4",
      "remeda": "2.46.0",
      "shiki": "4.4.3",
      "solid-list": "0.3.0",
      "tailwindcss": "4.3.3",
      "vite": "8.2.2",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "1.0.0",
      "@sentry/solid": "10.73.0",
      "@sentry/vite-plugin": "5.4.0",
      "solid-js": "1.9.15",
      "vite-plugin-solid": "2.11.14",
      "@lydell/node-pty": "1.2.0-beta.15"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/mime-types": "3.0.1",
    "husky": "9.1.7",
    "knip": "6.34.0",
    "marked": "catalog:",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "portless": "0.15.6",
    "prettier": "3.9.6",
    "react-doctor": "0.9.13",
    "turbo": "2.10.12"
  },
  "dependencies": {
    "@hena/script": "workspace:*",
    "@hena/sdk": "workspace:*",
    "@opencode-ai/plugin": "workspace:*",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hena-agent/hena"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "bun-types",
    "esbuild",
    "node-pty",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "tree-sitter-powershell",
    "web-tree-sitter",
    "electron"
  ],
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-orm": "catalog:",
    "vite": "catalog:"
  },
  "patchedDependencies": {
    "@silvia-odwyer/photon-node@0.3.4": "patches/@silvia-odwyer%2Fphoton-node@0.3.4.patch",
    "effect@4.0.0-beta.83": "patches/effect@4.0.0-beta.83.patch",
    "@ai-sdk/mistral@3.0.63": "patches/@ai-sdk%2Fmistral@3.0.63.patch",
    "@ai-sdk/google@3.0.121": "patches/@ai-sdk%2Fgoogle@3.0.121.patch",
    "@ai-sdk/xai@3.0.130": "patches/@ai-sdk%2Fxai@3.0.130.patch",
    "@pierre/trees@1.0.0-beta.6": "patches/@pierre%2Ftrees@1.0.0-beta.6.patch",
    "@modelcontextprotocol/sdk@1.30.0": "patches/@modelcontextprotocol%2Fsdk@1.30.0.patch",
    "@tanstack/virtual-core@3.17.8": "patches/@tanstack%2Fvirtual-core@3.17.8.patch",
    "@npmcli/agent@5.0.2": "patches/@npmcli%2Fagent@5.0.2.patch"
  }
}
