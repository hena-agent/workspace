{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "treatConfigHintsAsErrors": true,
  "ignoreExportsUsedInFile": true,
  // Namespace self-exports are the repository's public API convention. Knip cannot safely
  // distinguish their internal member usage and its fixer removes live declarations. Disabling
  // these rules also prevents Knip from reporting ordinary unused exports and types elsewhere.
  "rules": {
    "exports": "off",
    "types": "off",
    "namespaceMembers": "off",
  },
  "ignoreIssues": {
    "script/opencode/codex-web-search.ts": ["duplicates"],
    "packages/sdk/js/src/{gen,v2/gen}/**": [
      "nsExports",
      "nsTypes",
      "enumMembers",
      "duplicates",
    ],
    "packages/client/src/{generated,generated-effect}/**": [
      "nsExports",
      "nsTypes",
      "enumMembers",
      "duplicates",
    ],
    "packages/core/src/database/{migration,schema}.gen.ts": [
      "nsExports",
      "nsTypes",
      "enumMembers",
      "duplicates",
    ],
  },
  "workspaces": {
    ".": {
      "entry": [
        "script/**/*.{ts,mjs}",
        ".hena/tool/*.ts",
        ".hena/plugins/*.tsx",
      ],
      // github/ and sdks/vscode/ have independent package manifests and lockfiles.
      "project": ["script/**/*.{ts,mjs}", ".hena/**/*.{ts,tsx}"],
      // `marked` pins marked-shiki's peer for Bun's hoisted Windows linker.
      "ignoreDependencies": ["turbo", "marked"],
      "ignoreBinaries": ["hena"],
      "ignoreUnresolved": [
        "./script/build.ts",
        "./packages/sdk/js/script/build.ts",
        "./packages/hena/script/publish.ts",
        "./packages/cli/script/publish.ts",
        "./packages/sdk/js/script/publish.ts",
        "./packages/ui/script/publish.ts",
        "./packages/desktop/scripts/finalize-latest-json.ts",
        "./packages/desktop/scripts/finalize-latest-yml.ts",
        "./script/format.ts",
        "script/changelog.ts",
      ],
    },
    "packages/hena": {
      "entry": [
        "src/{index,node}.ts",
        "parsers-config.ts",
        "specs/**/*.ts",
        "**/*.test.{ts,tsx}",
        "test/fixture/**/*.{js,ts,tsx}",
        "script/**/*.{js,cjs,mjs,ts,cts,mts}",
      ],
      "includeEntryExports": true,
      "ignoreDependencies": [
        "@ff-labs/fff-bun",
        "@parcel/watcher",
        "tree-sitter-bash",
        "tree-sitter-powershell",
        // The Hena build injects this virtual module with the embedded web UI.
        "hena-web-ui.gen.ts",
        "ws",
        "@types/ws",
      ],
      "ignoreBinaries": ["sqlite3", "sha256sum", "makepkg", "ldd"],
    },
    "packages/app": {
      "entry": [
        "src/**/*.stories.{js,jsx,mjs,ts,tsx}",
        "**/*.test.{ts,tsx}",
        "test-browser/**/*.{ts,tsx}",
        "e2e/**/*.spec.ts",
        "e2e/**/playwright*.config.ts",
        "e2e/reproduction/**/*.{ts,tsx}",
      ],
      "ignoreUnresolved": ["@/context/global-sync"],
    },
    "packages/app-v3": {
      "entry": [
        "public/theme-preload.js",
        "integration/**/*.test.ts",
        "e2e/server.ts",
        "src/components/{ui,ai-elements}/**/*.tsx",
      ],
    },
    "packages/protocol": {
      "entry": ["**/*.test.{ts,tsx}"],
      "includeEntryExports": true,
    },
    "packages/schema": {
      "entry": ["**/*.test.{ts,tsx}"],
      "includeEntryExports": true,
    },
    "packages/server": {
      "entry": ["**/*.test.{ts,tsx}"],
      "includeEntryExports": true,
    },
    "packages/session-ui": {
      "entry": ["src/**/*.stories.{js,jsx,mjs,ts,tsx}", "src/**/*.worker.ts", "**/*.test.{ts,tsx}"],
      "includeEntryExports": true,
    },
    "packages/ui": {
      "entry": ["src/**/*.stories.{js,jsx,mjs,ts,tsx}", "**/*.test.{ts,tsx}", "script/**/*.{js,cjs,mjs,ts,cts,mts}"],
    },
    "packages/sdk/js": {
      "entry": ["**/*.test.{ts,tsx}", "script/**/*.{js,cjs,mjs,ts,cts,mts}", "example/**/*.{js,jsx,ts,tsx}"],
      "ignoreBinaries": ["dev"],
      "ignoreFiles": ["src/{gen,v2/gen}/**"],
    },
    "packages/httpapi-codegen": {
      "entry": ["**/*.test.{ts,tsx}", "test/generated-consumer.ts", "test/generated*/**/*.ts"],
    },
    "packages/llm": {
      "entry": ["**/*.test.{ts,tsx}", "test/**/*.types.ts", "{script,example}/**/*.{js,cjs,mjs,ts,cts,mts}"],
    },
    "packages/plugin": {
      "entry": ["src/example*.ts", "script/**/*.{js,cjs,mjs,ts,cts,mts}"],
    },
    "packages/desktop": {
      "entry": [
        "src/main/{index,sidecar}.ts",
        "src/renderer/index.html",
        "src/renderer/cli.ts",
        "**/*.test.{ts,tsx}",
        "scripts/**/*.{ts,mts}",
        "electron-builder.config.ts",
      ],
      "ignoreBinaries": ["pwsh", "wsl"],
      "ignoreUnresolved": ["./scripts/copy-icons.ts", "./scripts/copy-metainfo.ts", "script/build-node.ts"],
    },
    "packages/storybook": {
      "entry": [".storybook/**/*.{ts,tsx}"],
    },
    "packages/cli": {
      "entry": ["**/*.test.{ts,tsx}", "script/**/*.{js,cjs,mjs,ts,cts,mts}"],
      // The build script reads this version to install every platform binary before packaging.
      "ignoreDependencies": ["@opentui/core"],
    },
    "packages/core": {
      "entry": [
        "**/*.test.{ts,tsx}",
        "test/{fixture,fixtures,config/fixtures,plugin/fixtures}/**/*.{js,ts,tsx}",
        "script/**/*.{js,cjs,mjs,ts,cts,mts}",
      ],
      "includeEntryExports": true,
      "ignoreDependencies": [
        "@parcel/watcher-darwin-arm64",
        "@parcel/watcher-darwin-x64",
        "@parcel/watcher-linux-arm64-glibc",
        "@parcel/watcher-linux-arm64-musl",
        "@parcel/watcher-linux-x64-glibc",
        "@parcel/watcher-linux-x64-musl",
        "@parcel/watcher-win32-arm64",
        "@parcel/watcher-win32-x64",
      ],
    },
    "packages/effect-drizzle-sqlite": { "entry": ["examples/**/*.ts"] },
  },
}
