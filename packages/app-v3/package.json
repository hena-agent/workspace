{
  "name": "@hena/app-v3",
  "private": true,
  "version": "0.1.0",
  "description": "Hena Web UI V3 (React) — UI shell",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "bunx --package @typescript/native tsc -b && vite build",
    "build:embedded": "VITE_HENA_EMBEDDED=true bun run build",
    "e2e": "bun run build:embedded && playwright test",
    "preview": "vite preview",
    "typecheck": "bunx --package @typescript/native tsc -b",
    "test": "bun test --preload ./happydom.ts ./src ./vite-proxy.test.ts && bun test ./integration",
    "test:watch": "bun test --watch --preload ./happydom.ts ./src ./vite-proxy.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@hena/schema": "workspace:*",
    "@hena/server-v3": "workspace:*",
    "@shadcn/react": "0.3.0",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/db": "0.8.2",
    "@tanstack/react-db": "0.3.2",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "effect": "catalog:",
    "hono": "catalog:",
    "lucide-react": "1.29.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "catalog:",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@happy-dom/global-registrator": "20.0.11",
    "@playwright/test": "catalog:",
    "@rolldown/plugin-babel": "0.2.3",
    "@tanstack/router-plugin": "1.168.26",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/bun": "catalog:",
    "@types/babel__core": "7.20.5",
    "@types/node": "catalog:",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.16.2",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
