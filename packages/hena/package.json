{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "1.18.4",
  "name": "hena",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "typecheck": "bunx --package @typescript/native tsc --noEmit",
    "test": "bun test --timeout 30000 --only-failures",
    "test:httpapi": "bun run test:httpapi:coverage && bun run test:httpapi:auth && bun run test:httpapi:effect",
    "test:httpapi:coverage": "bun run script/httpapi-exercise.ts --mode coverage --fail-on-missing --fail-on-skip",
    "test:httpapi:auth": "bun run script/httpapi-exercise.ts --mode auth --fail-on-missing --fail-on-skip",
    "test:httpapi:effect": "bun run script/httpapi-exercise.ts --mode effect --fail-on-missing --fail-on-skip",
    "bench:test": "bun run script/bench-test-suite.ts",
    "profile:test": "bun run script/profile-test-files.ts",
    "build": "bun run script/build.ts",
    "dev": "bun run --conditions=browser ./src/index.ts"
  },
  "bin": {
    "hena": "./bin/hena"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "devDependencies": {
    "@hena/core": "workspace:*",
