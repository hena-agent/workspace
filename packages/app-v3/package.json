  "version": "0.1.0",
  "description": "Hena Web UI V3 (React) — UI shell",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "vite",
    "build": "bunx --package @typescript/native tsc -b && vite build",
    "build:embedded": "VITE_HENA_EMBEDDED=true bun run build",
    "e2e": "bun run build:embedded && playwright test",
    "preview": "vite preview",
    "typecheck": "bunx --package @typescript/native tsc -b",
    "test": "bun test --preload ./happydom.ts ./src ./vite-proxy.test.ts && bun test ./integration",
    "test:watch": "bun test --watch --preload ./happydom.ts ./src ./vite-proxy.test.ts"
  },
